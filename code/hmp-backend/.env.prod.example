# =============================================================================
# HTML_MeetingProtokol — PRODUCTION environment template
# =============================================================================
# IMPORTANT:
#   1. Copy:    cp .env.prod.example .env.prod
#   2. Edit:    replace EVERY placeholder marked CHANGE_ME
#   3. Secure:  chmod 600 .env.prod && chown hmp:hmp .env.prod
#   4. NEVER commit .env.prod — already in .gitignore
# =============================================================================

# --- Application ---
APP_NAME="HTML_MeetingProtokol API"
APP_VERSION="1.0.0"
APP_ENV="production"
DEBUG=false
LOG_LEVEL="INFO"

# --- Backend (FastAPI) ---
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
BACKEND_WORKERS=1
API_PREFIX="/api/v1/hmp"
# Add the production frontend origin(s) — comma-separated JSON list
CORS_ORIGINS='["https://hmp.example.com"]'

# --- Database (PostgreSQL) ---
# Production: postgres is on internal Docker network — host = service name
DATABASE_URL="postgresql+asyncpg://hmp:CHANGE_ME@postgres:5432/html_mp"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Postgres service-side credentials (used by docker-compose.prod.yml)
POSTGRES_DB="html_mp"
POSTGRES_USER="hmp"
POSTGRES_PASSWORD="CHANGE_ME_USE_A_32_PLUS_CHAR_RANDOM_PASSWORD"

# --- Ollama (optional, if running separately or as a sidecar) ---
OLLAMA_URL="http://ollama:11434"
OLLAMA_MODEL="llama3.1:8b"
OLLAMA_TIMEOUT=60

# --- Whisper (transcription) ---
WHISPER_MODEL="base"  # E184
WHISPER_DEVICE="cuda"
WHISPER_COMPUTE_TYPE="float16"  # E187: float16 на GPU быстрее без потери качества
WHISPER_CPU_THREADS=4  # меньше threads на сервере с GPU
WHISPER_CHUNK_DURATION_SEC=1800
WHISPER_USE_BATCHED_PIPELINE=false  # на prod с GPU не нужно
WHISPER_BEAM_SIZE=1
WHISPER_LANGUAGE="ru"

# --- pyannote.audio (diarization) ---
PYANNOTE_MODEL="pyannote/speaker-diarization-3.1"
HUGGINGFACE_TOKEN="CHANGE_ME_HF_TOKEN"

# --- LLM Providers (cloud, optional) ---
LLM_DEFAULT_PROVIDER="hermes"
LLM_FALLBACK_PROVIDER="gigachat"

HERMES_API_KEY="CHANGE_ME"
HERMES_BASE_URL="https://api.hermes.com/v1"

GIGACHAT_TOKEN="CHANGE_ME"
GIGACHAT_SCOPE="GIGACHAT_API_PERS"
GIGACHAT_BASE_URL="https://gigachat.devices.sberbank.ru/api/v1"

# --- Memory monitoring ---
RSS_LIMIT_MB=4096
RSS_CHECK_INTERVAL_SEC=5

# --- Telegram Bot (optional) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_WEBHOOK_URL=""
TELEGRAM_BOT_WEBHOOK_SECRET="CHANGE_ME_LONG_RANDOM"

# --- File storage ---
# Inside the container, hmp user lives at /home/hmp — this is the in-container path
DATA_DIR="/home/hmp/.html_mp"
PROTOCOLS_DIR="/home/hmp/.html_mp/protocols"
BACKUP_DIR="/home/hmp/.html_mp/backup"

# --- Cloud storage ---
CLOUD_DOWNLOAD_TIMEOUT=300
CLOUD_MAX_FILE_SIZE_MB=10240

# --- Security ---
# Generate: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_MASTER_KEY="CHANGE_ME_BASE64_32_BYTES"
ENCRYPTION_ALGORITHM="AES-256-GCM"

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=""
METRICS_ENABLED=false

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=100

# --- Video streaming ---
VIDEO_RANGE_CHUNK_SIZE_MB=8

# --- Reverse proxy / domain ---
# Used by docker-compose.prod.yml (Caddy) and the deployment script
HMP_DOMAIN="hmp.example.com"
HMP_ACME_EMAIL="admin@example.com"
