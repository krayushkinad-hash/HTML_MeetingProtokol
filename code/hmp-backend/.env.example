# =============================================================================
# HTML_MeetingProtokol — Environment Variables Template
# Copy to .env and fill in your values
# =============================================================================

# --- Application ---
APP_NAME="HTML_MeetingProtokol API"
APP_VERSION="1.0.0"
APP_ENV="development"  # development | staging | production
DEBUG=true
LOG_LEVEL="INFO"  # DEBUG | INFO | WARNING | ERROR

# --- Backend (FastAPI) ---
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
BACKEND_WORKERS=1  # Single-worker per ADR-009
API_PREFIX="/api/v1/hmp"
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000"]'

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql+asyncpg://hmp:changeme@127.0.0.1:5432/html_mp"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Ollama (optional local LLM) ---
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
OLLAMA_TIMEOUT=60

# --- Whisper (transcription) ---
WHISPER_MODEL="base"  # E184: tiny|base|small|medium|large-v3 (default = base, не large!)
WHISPER_DEVICE="cpu"     # cuda|cpu
WHISPER_COMPUTE_TYPE="int8"  # float16|int8|float32 — E187: int8 = 2x быстрее чем float16
WHISPER_CPU_THREADS=8  # E187: число CPU threads для Whisper (1.5x ускорение)
WHISPER_CHUNK_DURATION_SEC=1800  # E187: длина чанка (30 мин) для длинных аудио
WHISPER_USE_BATCHED_PIPELINE=false  # E187: BatchedInferencePipeline (2-3x, но больше RAM)
WHISPER_BEAM_SIZE=1
WHISPER_LANGUAGE="ru"

# --- pyannote.audio (diarization) ---
PYANNOTE_MODEL="pyannote/speaker-diarization-3.1"
HUGGINGFACE_TOKEN=""  # Get from https://huggingface.co/settings/tokens

# --- LLM Providers (cloud, optional) ---
LLM_DEFAULT_PROVIDER="hermes"  # hermes|gigachat|local_ollama
LLM_FALLBACK_PROVIDER="gigachat"

# Hermes
HERMES_API_KEY=""
HERMES_BASE_URL="https://api.hermes.com/v1"

# GigaChat (ФСТЭК certified)
GIGACHAT_TOKEN=""
GIGACHAT_SCOPE="GIGACHAT_API_PERS"
GIGACHAT_BASE_URL="https://gigachat.devices.sberbank.ru/api/v1"

# --- Memory monitoring (OOM protection) ---
RSS_LIMIT_MB=4096  # Auto-pause at 80% = 3277 MB
RSS_CHECK_INTERVAL_SEC=5

# --- Telegram Bot (optional, runs separately) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_WEBHOOK_URL=""
TELEGRAM_BOT_WEBHOOK_SECRET=""

# --- File storage ---
DATA_DIR="~/.html_mp"
PROTOCOLS_DIR="~/.html_mp/protocols"
BACKUP_DIR="~/.html_mp/backup"

# --- Cloud storage (for HTTPS download) ---
CLOUD_DOWNLOAD_TIMEOUT=300  # seconds
CLOUD_MAX_FILE_SIZE_MB=10240  # 10 GB

# --- Security (per ADR-014) ---
ENCRYPTION_MASTER_KEY=""  # 32 bytes, base64-encoded; generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_ALGORITHM="AES-256-GCM"

# --- Observability (NFR §13) ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=""
METRICS_ENABLED=false

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=100

# --- Whisper HTTP Range (for video streaming) ---
VIDEO_RANGE_CHUNK_SIZE_MB=8
