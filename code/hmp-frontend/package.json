{
  "name": "hmp-frontend-tests",
  "version": "1.0.0",
  "description": "Frontend tests for HTML_MeetingProtokol (HMP) — vanilla JS, no framework",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:unit": "jest --config jest.config.cjs --testPathPattern=tests/(api|views|utils)/",
    "test:e2e": "playwright test --config=playwright.config.js",
    "test:e2e:install": "playwright install --with-deps chromium",
    "coverage": "jest --config jest.config.cjs --coverage",
    "lint": "eslint tests/ --ext .js",
    "lint:fix": "eslint tests/ --ext .js --fix",
    "format": "prettier --write \"tests/**/*.js\" \"*.config.js\" \"*.config.cjs\"",
    "format:check": "prettier --check \"tests/**/*.js\" \"*.config.js\" \"*.config.cjs\""
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@playwright/test": "^1.47.2",
    "@testing-library/dom": "^10.4.0",
    "@types/jest": "^29.5.13",
    "eslint": "^9.12.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
