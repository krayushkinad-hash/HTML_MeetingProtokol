# Database
DATABASE_URL=postgresql+asyncpg://hmp:hmp_password@localhost:5432/html_mp

# Security
SECRET_KEY=change-me-in-production-min-32-chars-random-string
ENCRYPTION_MASTER_KEY=

# Server
HOST=127.0.0.1
PORT=8000
ENV=development
LOG_LEVEL=INFO

# ML Models (optional)
WHISPER_MODEL=large-v3
# PYANNOTE_TOKEN=  # DEPRECATED: requires gated access on HF. Use NeMo Sortformer instead (auto-install via deploy scripts).

# AI providers (optional)
HERMES_API_KEY=
GIGACHAT_TOKEN=
OPENAI_API_KEY=

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
# ============================================================
# DEV OPTIONS (НЕ ВКЛЮЧАТЬ В PRODUCTION!)
# ============================================================
# Если true — при старте backend DROP DATABASE html_mp и CREATE заново
# Все данные будут УДАЛЕНЫ без возможности восстановления
# Использовать только для полного сброса после больших изменений
RESET_DB=false

# Если true — записать HEAD миграцию в БД при старте
# (по умолчанию работает через универсальный reflection)
MIGRATION_ENABLED=true
# ============================================================
# E061: PROXY SETTINGS (disable if SOCKS causes errors)
# ============================================================
# Uncomment to override proxy detection. By default, all proxy
# env vars are CLEARED at backend startup (E061) to fix
# "Unknown scheme for proxy URL socks4://..." errors.
#
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=
# SOCKS_PROXY=
